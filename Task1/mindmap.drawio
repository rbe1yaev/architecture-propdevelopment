                </mxCell>
                <mxCell id="106" value="Без централизованной политики хранения логов теряется возможность расследования инцидентов и аудита.&amp;nbsp;" style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1218" width="410" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="107" value="" style="edgeStyle=none;html=1;" parent="205" source="108" target="109" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="108" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Искажение&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Значительный&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="205" vertex="1">
                    <mxGeometry x="1760" y="1298" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="109" value="Подмена или удаление логов злоумышленником позволяет скрыть следы атаки и затрудняет обнаружение инцидентов." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1298" width="370" height="60" as="geometry"/>
                </mxCell>
