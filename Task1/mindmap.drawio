                </mxCell>
                <mxCell id="159" value="Ошибочное изменение контактных данных клиента (например, оператором CRM) приводит к потере связи с клиентом, срыву сделок." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="670" y="1500" width="370" height="60" as="geometry"/>
                </mxCell>
