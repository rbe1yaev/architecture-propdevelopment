                </mxCell>
                <mxCell id="152" value="Утечка&lt;br&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Критический&lt;/span&gt;)" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="205" vertex="1">
                    <mxGeometry x="480" y="1400" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="155" value="Данные хранятся в нескольких системах без единой политики доступа. Есть уязвимость: клиенты видели чужие данные в ЛК. Прямое нарушение 152-ФЗ, штрафы, потеря доверия, отток клиентов." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="670" y="1400" width="490" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="157" value="" style="edgeStyle=none;html=1;" parent="205" source="158" target="159" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="158" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Искажение&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Значительный&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="205" vertex="1">
