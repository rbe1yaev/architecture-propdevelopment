                </mxCell>
                <mxCell id="141" value="Изменение конфигурации сети или кластеров может привести к остановке сервисов, открытию неавторизованного доступа или перенаправлению трафика злоумышленнику." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1990" width="370" height="60" as="geometry"/>
                </mxCell>
