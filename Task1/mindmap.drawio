                <mxCell id="168" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Потеря&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Критический&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="205" vertex="1">
                    <mxGeometry x="700" y="1785" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="169" value="Компрометация базы аутентификации позволяет злоумышленнику войти в ЛК любого клиента или собственника. Полный доступ к перс. даным, данным о сделках, заявкам." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="890" y="1695" width="490" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="170" value="Потеря базы пользователей делает невозможным вход для всех клиентов и собственников → полная остановка продаж и ЖКУ-сервисов." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="890" y="1785" width="410" height="60" as="geometry"/>
