                </mxCell>
                <mxCell id="116" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Потеря&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Значительный&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="205" vertex="1">
                    <mxGeometry x="1760" y="1475" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="117" value="BI-отчёты содержат агрегированную информацию о продажах, финансовых показателях и стратегических KPI. Утечка даёт конкурентам преимущество.&amp;nbsp;" style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1385" width="490" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="118" value="Потеря исторических данных в хранилище делает невозможным трендовый анализ и сравнение периодов, подрывая ценность BI-системы." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1475" width="410" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="119" value="" style="edgeStyle=none;html=1;" parent="205" source="120" target="121" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="120" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Искажение&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Значительный&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="205" vertex="1">
