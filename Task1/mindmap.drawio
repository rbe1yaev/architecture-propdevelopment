                </mxCell>
                <mxCell id="124" value="Аналитические данные быстро теряют актуальность. Например запаздывание ETL-процессов приводит к тому, что решения принимаются на основе устаревшей информации." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1640" width="370" height="60" as="geometry"/>
                </mxCell>
