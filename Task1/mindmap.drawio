                </mxCell>
                <mxCell id="121" value="Подмена данных в DWH приводит к неверным управленческим решениям на основе искажённой аналитики." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1555" width="370" height="60" as="geometry"/>
