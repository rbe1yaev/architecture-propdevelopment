                </mxCell>
                <mxCell id="137" value="Конфигурационный файлы содержат строки подключения к БД, эндпоинты внутренних сервисов, настройки firewall, и тп. Компрометация конфигураций даёт злоумышленнику план атаки на всю инфраструктуру.&amp;nbsp;" style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1820" width="490" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="138" value="Утеря актуальных конфигураций затрудняет восстановление среды после сбоя." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1910" width="410" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="139" value="" style="edgeStyle=none;html=1;" parent="205" source="140" target="141" edge="1">
