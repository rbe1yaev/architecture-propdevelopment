                <mxCell id="148" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Некачественные данные&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Критический&lt;/span&gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="205" vertex="1">
                    <mxGeometry x="1760" y="1730" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="149" value="Множественные точки регистрации клиентов создают дубликаты в исходных данных. Потоки интеграций переносят эти дубликаты в DWH, и BI-отчёты строятся на противоречивых данных." style="whiteSpace=wrap;html=1;rounded=1;" parent="205" vertex="1">
                    <mxGeometry x="1950" y="1730" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="150" value="" style="endArrow=classic;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="205" source="24" target="148" edge="1">
